# Copy to .env and fill in real values. Never commit .env.
#
# Required: master key used to authenticate management API calls (/api/v1/*).
# Keep the placeholder invalid; placeholder values containing "change-me" are rejected.
GATEWAY_MASTER_KEY=change-me-to-a-long-random-string

# Required: development | test | production
GATEWAY_ENVIRONMENT=development

# memory | postgres. "memory" keeps keys and models in process memory and is
# intended for local experiments and tests only.
GATEWAY_STORAGE_BACKEND=memory

# Required when GATEWAY_STORAGE_BACKEND=postgres. docker-compose.yml exposes
# PostgreSQL on localhost:5432 with these credentials.
GATEWAY_DATABASE_URL=postgresql+asyncpg://gateway:gateway@localhost:5432/gateway

# Reserved for future rate limiting and caching. Not used by the MVP.
GATEWAY_REDIS_URL=redis://localhost:6379/0

# OpenAI provider. Leave the API key empty to disable the provider.
GATEWAY_OPENAI_API_KEY=
GATEWAY_OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek (OpenAI-compatible). Leave the API key empty to disable the provider.
GATEWAY_DEEPSEEK_API_KEY=
GATEWAY_DEEPSEEK_BASE_URL=https://api.deepseek.com

# Enables the deterministic fake provider (model provider "fake"). Must stay
# false in production.
GATEWAY_FAKE_PROVIDER_ENABLED=false

GATEWAY_LOG_LEVEL=INFO
GATEWAY_REQUEST_TIMEOUT_SECONDS=60
GATEWAY_CONNECT_TIMEOUT_SECONDS=10
GATEWAY_MAX_RETRIES=2

# Request audit capture. Disabled by default; tenants must also opt in.
GATEWAY_AUDIT_ENABLED=false
# Maximum bytes of prompt/response content stored per request.
GATEWAY_AUDIT_MAX_CONTENT_BYTES=262144
# Upper bound for a background audit write before it is abandoned.
GATEWAY_AUDIT_WRITE_TIMEOUT_SECONDS=2

# Distributed tracing (W3C trace context). Disabled by default: no spans are
# recorded and no traceparent header is sent upstream. Enabling requires an
# OTLP/HTTP endpoint, for example http://127.0.0.1:4318/v1/traces.
GATEWAY_TRACING_ENABLED=false
GATEWAY_TRACING_ENDPOINT=
# Head-based sampling ratio in [0, 1]; an upstream sampling decision is honored.
GATEWAY_TRACING_SAMPLE_RATIO=0.1
GATEWAY_TRACING_SERVICE_NAME=llm-gateway
GATEWAY_TRACING_EXPORT_TIMEOUT_SECONDS=5

# Prometheus metrics on a dedicated port. Disabled by default.
GATEWAY_METRICS_ENABLED=false
GATEWAY_METRICS_HOST=127.0.0.1
GATEWAY_METRICS_PORT=9464
GATEWAY_METRICS_SERVICE_NAME=llm-gateway

# Cost accounting. Single deployment currency; prices are per million tokens.
GATEWAY_BILLING_CURRENCY=USD

# Management-plane identity. The master key stays a break-glass owner path.
GATEWAY_MASTER_KEY_ENABLED=true
GATEWAY_SESSION_TTL_HOURS=12
# Optional first-run owner. Created only when no active owner exists; never resets.
GATEWAY_BOOTSTRAP_ADMIN_USERNAME=
GATEWAY_BOOTSTRAP_ADMIN_PASSWORD=

# Request guards. Bodies above the byte limit get 413; other limits get 400.
GATEWAY_MAX_REQUEST_BYTES=1048576
GATEWAY_MAX_MESSAGES=200
GATEWAY_MAX_PROMPT_CHARS=1000000
GATEWAY_MAX_TOKENS_LIMIT=32768
GATEWAY_MAX_TOOLS=128
